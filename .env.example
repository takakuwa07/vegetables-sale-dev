# 開発用の例。DB接続情報と担当者を記入して .env.development にコピーする。
# 接続台帳 application は vegetables_maintenance_db を指定する。
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_COMMON_NAME=common_db
APP_PORT=2001
# 開発ログは業務サーバーの /server-log-viewer/index-log-viewer.html に統合する。
LIVE_RELOAD_PORT=35001
DEPLOY_INITIALS=
DEPLOY_TARGET_DIR=C:/dev/vegetables-sale-prod
