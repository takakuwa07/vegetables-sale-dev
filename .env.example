# 開発用の例。DB接続情報と担当者を記入して .env.development にコピーする。
# npm run db:setupで本番・開発のDBと表を作成する。
# DB_CONFIG_NAMEは基底名。開発時は設定DB・業務DBの両方に-devが自動で付く。
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONFIG_NAME=application_config_db
APP_PORT=2001
# ログ画面は業務サーバーとは別の専用ポートで起動する。
LOG_PORT=2601
LIVE_RELOAD_PORT=35001
DEPLOY_INITIALS=
DEPLOY_TARGET_DIR=C:/dev/app-prod
