{
  "name": "data-viewer",
  "version": "1.0.1",
  "description": "データ一覧の閲覧と本番リリースの切り替え",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "dep": "node scripts/deploy-prod.js",
    "depfo": "node scripts/deploy-prod.js --force",
    "releases": "node scripts/rollback-prod.js --list",
    "rollback": "node scripts/rollback-prod.js",
    "prod:setup": "node scripts/setup-production.js",
    "db:setup": "node scripts/setup-database.js",
    "db:generate": "node scripts/generate-database-setup.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "mssql": "^12.5.0"
  },
  "devDependencies": {
    "connect-livereload": "^0.6.1",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "private": true
}
